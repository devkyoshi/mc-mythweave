#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Text files are stored with LF in the repository and checked out with each OS's native
# line endings, so Windows and Linux/macOS contributors don't fight over them.
* text=auto

# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary assets: never touch their bytes
*.png           binary
*.jar           binary
