# Editor settings shared by everyone (most IDEs read this automatically).
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,gradle,ps1,cmd}]
indent_style = tab

[*.{json,mcmeta,md,yml,yaml}]
indent_style = space
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf
